@@ -0,0 +1,53 @@
+// SPDX-FileCopyrightText: 2026 Contributors to Chatterino <https://chatterino.com>
+//
+// SPDX-License-Identifier: MIT
+
+#pragma once
+
+#include <pajlada/signals/signalholder.hpp>
+
+#include <QLabel>
+#include <QTimer>
+#include <QWidget>
+
+namespace chatterino {
+
+/**
+ * Phone device styles (Galaxy Fold / iPhone, style only).
+ *
+ * The status bar at the top of the main window: live clock on the left,
+ * the phone's camera in the middle (punch-hole dot on the Fold, black
+ * notch pill on iPhone), signal / battery on the right. The clock is
+ * real (the PC clock); battery and signal are drawn icons, not live
+ * hardware readings - a desktop app has no phone battery or signal.
+ */
+class DevicePhoneBar : public QWidget
+{
+    Q_OBJECT
+
+public:
+    explicit DevicePhoneBar(QWidget *parent);
+
+private:
+    void updateBar();
+
+    QLabel *timeLabel_;
+    QLabel *cameraLabel_;
+    QLabel *statusLabel_;
+    QTimer clockTimer_;
+    pajlada::Signals::SignalHolder signalHolder_;
+};
+
+/**
+ * Apply a phone device style, changing the WHOLE app together:
+ * the theme (GalaxyFold / iPhoneDark), the tab bar (bottom, both
+ * phones) and the message bubbles (driven by the deviceStyle setting
+ * in MessageLayout). Colours, theme and bubbles switch live; the
+ * window frame size is applied when the app restarts (see Window).
+ */
+void applyDeviceStyle(const QString &style);
+
+/// True when the picked phone is the Samsung Galaxy Fold.
+bool deviceStyleIsFold();
+
+}  // namespace chatterino
