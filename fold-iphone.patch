+// ---------------------------------------------------------------------------
+// Phone device styles (Galaxy Fold / iPhone, style only).
+// Used only when a phone device style is active (both built-in styles
+// are phone styles). They never touch channels, protocols, moderation,
+// or emote providers. The platform outline is purple for Twitch
+// (145, 70, 255) and green for Kick (83, 252, 24).
+// ---------------------------------------------------------------------------
+
+bool phoneStyleEnabled()
+{
+    // Both device styles are phone styles; deviceStyle only ever holds
+    // "GalaxyFold" or "iPhone".
+    return !getSettings()->deviceStyle.getValue().isEmpty();
+}
+
+bool phoneIsFold()
+{
+    return getSettings()->deviceStyle.getValue() == "GalaxyFold";
+}
+
+/// True when this message was sent by the currently logged-in account, on
+/// either platform. Twitch and Kick accounts are checked independently, so
+/// a user logged in as official_robust_clan on both is "own" on both.
+/// Anonymous accounts never match: an empty login name is not own.
+bool phoneIsOwnMessage(const Message &message)
+{
+    if (message.loginName.isEmpty())
+    {
+        return false;
+    }
+    auto *accounts = getApp()->getAccounts();
+    if (accounts == nullptr)
+    {
+        return false;
+    }
+    if (auto twitch = accounts->twitch.getCurrent(); twitch != nullptr &&
+        !twitch->isAnon() &&
+        twitch->getUserName().compare(message.loginName,
+                                      Qt::CaseInsensitive) == 0)
+    {
+        return true;
+    }
+    if (auto kick = accounts->kick.current(); kick != nullptr &&
+        !kick->isAnonymous() &&
+        kick->username().compare(message.loginName, Qt::CaseInsensitive) ==
+            0)
+    {
+        return true;
+    }
+    return false;
+}
+
+QString phoneDisplayName(const Message &message)
+{
+    return message.displayName.isEmpty() ? message.loginName
+                                         : message.displayName;
+}
+
+/// The single initial painted in the avatar circle for received messages.
+/// Initials only: Qt chat rows carry no per-message profile photo.
+QChar phoneAvatarInitial(const Message &message)
+{
+    const QString name = phoneDisplayName(message);
+    return name.isEmpty() ? QChar('?') : name.at(0).toUpper();
+}
+
+QColor phoneOutlineColor(const Message &message)
+{
+    return message.platform == MessagePlatform::Kick
+               ? QColor(83, 252, 24)
+               : QColor(145, 70, 255);
+}
+
+/// Bubble fill for phone styles. Sent messages use the phone's message
+/// blue (Samsung blue on Fold, iOS blue on iPhone); received messages
+/// use the system grey for the current theme, inferred from the chat
+/// text colour (dark text = light theme). Highlighted messages keep
+/// their highlight colour as the fill instead; see updateBuffer.
+QColor phoneBubbleFill(const QColor &textColor, bool isOwn, bool isFold)
+{
+    if (isOwn)
+    {
+        return isFold ? QColor("#0381fe") : QColor("#0a84ff");
+    }
+    const bool lightTheme = textColor.lightness() < 128;
+    if (lightTheme)
+    {
+        return isFold ? QColor("#e8e8ed") : QColor("#e9e9eb");
+    }
+    return QColor("#2c2c2e");
+}
