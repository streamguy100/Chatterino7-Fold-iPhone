+// SPDX-FileCopyrightText: 2026 Contributors to Chatterino <https://chatterino.com>
+//
+// SPDX-License-Identifier: MIT
+
+#pragma once
+
+#include <pajlada/signals/signalholder.hpp>
+
+#include <QLabel>
+#include <QPushButton>
+#include <QWidget>
+
+#include <vector>
+
+namespace chatterino {
+
+/**
+ * Code Screen (passcode lock, local only).
+ *
+ * A full-screen lock shown on launch when Code Screen is on and a code
+ * has been set. The look follows the picked phone: iOS "Enter Passcode"
+ * on iPhone, Samsung One UI "Enter PIN" on the Galaxy Fold.
+ *
+ * The code is stored locally in the app settings on this PC. It is a
+ * local lock screen, not real account security: anyone who can read
+ * the settings file could read it.
+ */
+class DevicePasscodeScreen : public QWidget
+{
+    Q_OBJECT
+
+public:
+    explicit DevicePasscodeScreen(QWidget *parent);
+
+    /// True when the lock should be shown on launch: Code Screen is on
+    /// AND a code has been set. If no code was ever set there is no
+    /// lock screen at all - the app opens straight to chats.
+    static bool lockActive();
+
+    /// True when the "no passcode yet" hint should be shown: Code
+    /// Screen is off or no code is set, and the hint has not been
+    /// dismissed. Turning Code Screen off again or clearing the code
+    /// brings the hint back (see CodeScreenPage).
+    static bool hintVisible();
+
+Q_SIGNALS:
+    void unlocked();
+
+private:
+    enum class Mode {
+        Enter,
+        SetNew,
+    };
+
+    void buildUi();
+    void updateStyle();
+    void updateDots();
+    void shakeDots();
+    void appendDigit(const QString &digit);
+    void deleteDigit();
+    void checkEntered();
+    void switchToSetNew();
+    void switchToEnter();
+    void saveNewCode();
+    void unlock();
+
+    Mode mode_ = Mode::Enter;
+    QString entered_;
+    QLabel *titleLabel_ = nullptr;
+    QLabel *statusLabel_ = nullptr;
+    QWidget *dotsWidget_ = nullptr;
+    std::vector<QLabel *> dotLabels_;
+    QPushButton *forgotButton_ = nullptr;
+    QPushButton *setButton_ = nullptr;
+    QPushButton *cancelButton_ = nullptr;
+    pajlada::Signals::SignalHolder signalHolder_;
+};
+
+}  // namespace chatterino
