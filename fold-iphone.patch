+
+#pragma once
+
+#include "widgets/settingspages/SettingsPage.hpp"
+
+class QLabel;
+class QLineEdit;
+
+namespace chatterino {
+
+/**
+ * Settings -> Code Screen: the passcode lock for the app.
+ *
+ * Toggle the lock on/off and set your own 4-6 digit code. The code is
+ * stored locally in the app settings on this PC - a local lock screen,
+ * not real account security.
+ *
+ * If no code was ever set, there is no lock screen at all and the app
+ * opens straight to chats. This page (and the dismissible hint above
+ * the chats) nudges him to set one, so no one else using this PC can
+ * type as him.
+ */
+class CodeScreenPage : public SettingsPage
+{
+    Q_OBJECT
+
+public:
+    CodeScreenPage();
+
+private:
+    void refreshLabels();
+
+    QLabel *hintLabel_ = nullptr;
+    QLabel *statusLabel_ = nullptr;
+    QLabel *savedLabel_ = nullptr;
+    QLineEdit *codeEdit_ = nullptr;
+};
+
+}  // namespace chatterino
