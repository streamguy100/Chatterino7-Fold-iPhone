+// SPDX-FileCopyrightText: 2026 Contributors to Chatterino <https://chatterino.com>
+//
+// SPDX-License-Identifier: MIT
+
+#include "widgets/settingspages/DeviceStylePage.hpp"
+
+#include "singletons/Settings.hpp"
+#include "widgets/DevicePhone.hpp"
+
+#include <QButtonGroup>
+#include <QCheckBox>
+#include <QLabel>
+#include <QRadioButton>
+#include <QVBoxLayout>
+
+namespace chatterino {
+
+DeviceStylePage::DeviceStylePage()
+{
+    auto *layout = new QVBoxLayout(this);
+    layout->setContentsMargins(12, 12, 12, 12);
+    layout->setSpacing(10);
+
+    auto *title = new QLabel("Device Style", this);
+    title->setStyleSheet("font-size: 18px; font-weight: bold;");
+    layout->addWidget(title);
+
+    auto *description = new QLabel(
+        "Pick the phone the whole app looks like. The whole app changes "
+        "together: the frame, the status bar and camera at the top, the "
+        "header, the tabs at the bottom, the input at the bottom, the "
+        "colours, the buttons and the chat bubbles. Colours, theme and "
+        "bubbles switch right away. The window frame (tall narrow phone, "
+        "punch-hole or notch) applies when you restart the app.",
+        this);
+    description->setWordWrap(true);
+    layout->addWidget(description);
+
+    auto *group = new QButtonGroup(this);
+
+    this->foldButton_ = new QRadioButton(
+        "Samsung Galaxy Fold — One UI, Samsung blue, punch-hole camera",
+        this);
+    this->foldButton_->setToolTip(
+        "Tall narrow phone frame, One UI dark look, Samsung Messages "
+        "bubbles: blue sent, grey received.");
+    group->addButton(this->foldButton_);
+    layout->addWidget(this->foldButton_);
+
+    this->iphoneButton_ = new QRadioButton(
+        "iPhone — iOS Messages, blue bubbles, notch", this);
+    this->iphoneButton_->setToolTip(
+        "iPhone Messages bubbles: received on the left, your own messages "
+        "on the right, username above the message, no timestamps.");
+    group->addButton(this->iphoneButton_);
+    layout->addWidget(this->iphoneButton_);
+
+    if (deviceStyleIsFold())
+    {
+        this->foldButton_->setChecked(true);
+    }
+    else
+    {
+        this->iphoneButton_->setChecked(true);
+    }
+
+    QObject::connect(this->foldButton_, &QRadioButton::toggled, this,
+                     [](bool checked) {
+                         if (checked)
+                         {
+                             applyDeviceStyle("GalaxyFold");
+                         }
+                     });
+    QObject::connect(this->iphoneButton_, &QRadioButton::toggled, this,
+                     [](bool checked) {
+                         if (checked)
+                         {
+                             applyDeviceStyle("iPhone");
+                         }
+                     });
+
+    this->avatarCheckbox_ = new QCheckBox(
+        "Show avatar initials in phone styles", this);
+    this->avatarCheckbox_->setToolTip(
+        "Paint the sender's initial in a small circle next to received "
+        "messages. Initials only, not a fetched profile photo.");
+    this->avatarCheckbox_->setChecked(
+        getSettings()->phoneMessageShowAvatars.getValue());
+    QObject::connect(this->avatarCheckbox_, &QCheckBox::toggled, this,
+                     [](bool checked) {
+                         getSettings()->phoneMessageShowAvatars.setValue(
+                             checked);
+                     });
+    layout->addWidget(this->avatarCheckbox_);
+
+    layout->addStretch();
+}
+
+}  // namespace chatterino
