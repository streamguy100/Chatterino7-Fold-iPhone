diff --git a/src/widgets/DeviceHomeScreen.cpp b/src/widgets/DeviceHomeScreen.cpp
new file mode 100644
index 000000000..6f6787861
--- /dev/null
+++ b/src/widgets/DeviceHomeScreen.cpp
@@ -0,0 +1,213 @@
+// SPDX-FileCopyrightText: 2026 Contributors to Chatterino <https://chatterino.com>
+//
+// SPDX-License-Identifier: MIT
+
+#include "widgets/DeviceHomeScreen.hpp"
+
+#include "singletons/Settings.hpp"
+#include "singletons/Theme.hpp"
+#include "widgets/DevicePhone.hpp"
+#include "widgets/Notebook.hpp"
+
+#include <QGridLayout>
+#include <QLabel>
+#include <QPushButton>
+#include <QVBoxLayout>
+
+namespace chatterino {
+
+namespace {
+
+/// App-icon colours, cycled per channel (initials only - Qt chat rows
+/// carry no per-message profile photo, and tabs carry no photo either).
+const QStringList iconColors = {
+    "#0381fe",  // Samsung blue
+    "#8e44ad",  // Twitch purple-ish
+    "#00c853",  // Kick green-ish
+    "#ff6d00",
+    "#00acc1",
+    "#e91e63",
+};
+
+}  // namespace
+
+DeviceHomeScreen::DeviceHomeScreen(QWidget *parent, SplitNotebook *notebook)
+    : QWidget(parent)
+    , notebook_(notebook)
+{
+    this->setAttribute(Qt::WA_StyledBackground, true);
+
+    auto *layout = new QVBoxLayout(this);
+    layout->setContentsMargins(20, 24, 20, 20);
+    layout->setSpacing(16);
+
+    auto *title = new QLabel("Home", this);
+    title->setStyleSheet("font-size: 26px; font-weight: bold;");
+    layout->addWidget(title);
+
+    auto *subtitle = new QLabel(
+        "Tap an app to open that chat. Tap the Home button at the top "
+        "to come back here.",
+        this);
+    subtitle->setWordWrap(true);
+    subtitle->setStyleSheet("font-size: 13px; color: #888888;");
+    layout->addWidget(subtitle);
+
+    this->gridWidget_ = new QWidget(this);
+    layout->addWidget(this->gridWidget_, 1, Qt::AlignTop);
+    layout->addStretch(1);
+
+    this->updateStyle();
+    getSettings()->deviceStyle.connect(
+        [this](const QString &) {
+            this->updateStyle();
+            this->refresh();
+        },
+        this->signalHolder_);
+}
+
+void DeviceHomeScreen::updateStyle()
+{
+    const bool isFold = deviceStyleIsFold();
+    const bool lightTheme = getTheme()->isLightTheme();
+    const QString bg =
+        isFold ? "#121417" : (lightTheme ? "#f2f2f7" : "#1c1c1e");
+    const QString text = lightTheme && !isFold ? "#000000" : "#ffffff";
+    this->setStyleSheet(QStringLiteral("background-color: %1; color: %2;")
+                            .arg(bg, text));
+}
+
+void DeviceHomeScreen::refresh()
+{
+    // Clear the old grid.
+    if (auto *oldLayout = this->gridWidget_->layout())
+    {
+        QLayoutItem *item = nullptr;
+        while ((item = oldLayout->takeAt(0)) != nullptr)
+        {
+            if (item->widget() != nullptr)
+            {
+                item->widget()->deleteLater();
+            }
+            delete item;
+        }
+        delete oldLayout;
+    }
+
+    auto *grid = new QGridLayout(this->gridWidget_);
+    grid->setContentsMargins(0, 0, 0, 0);
+    grid->setSpacing(16);
+
+    const bool isFold = deviceStyleIsFold();
+    int row = 0;
+    int col = 0;
+    int index = 0;
+
+    for (const auto &item : this->notebook_->items())
+    {
+        if (item.tab == nullptr || item.page == nullptr)
+        {
+            continue;
+        }
+        const QString name = item.tab->getTitle();
+        if (name.isEmpty())
+        {
+            continue;
+        }
+        QWidget *page = item.page;
+
+        auto *cell = new QWidget(this->gridWidget_);
+        auto *cellLayout = new QVBoxLayout(cell);
+        cellLayout->setContentsMargins(0, 0, 0, 0);
+        cellLayout->setSpacing(6);
+
+        auto *icon = new QPushButton(cell);
+        const QString initial =
+            name.left(1).toUpper();
+        icon->setText(initial);
+        icon->setFixedSize(72, 72);
+        // iPhone icons are squarer with big rounding, Fold icons are
+        // One UI rounded squares.
+        icon->setStyleSheet(
+            QStringLiteral(
+                "QPushButton { background-color: %1; color: #ffffff; "
+                "font-size: 30px; font-weight: bold; border-radius: %2px; }"
+                "QPushButton:pressed { background-color: #0381fe; }")
+                .arg(iconColors.at(index % iconColors.size()),
+                     isFold ? "20" : "18"));
+        QObject::connect(icon, &QPushButton::clicked, this,
+                         [this, page] {
+                             this->openPage(page);
+                         });
+        cellLayout->addWidget(icon, 0, Qt::AlignCenter);
+
+        auto *label = new QLabel(name, cell);
+        label->setAlignment(Qt::AlignCenter);
+        label->setStyleSheet("font-size: 12px;");
+        label->setWordWrap(true);
+        cellLayout->addWidget(label);
+
+        grid->addWidget(cell, row, col);
+        col++;
+        if (col >= 4)
+        {
+            col = 0;
+            row++;
+        }
+        index++;
+    }
+
+    // "New chat" tile: opens a fresh tab, then that chat.
+    {
+        auto *cell = new QWidget(this->gridWidget_);
+        auto *cellLayout = new QVBoxLayout(cell);
+        cellLayout->setContentsMargins(0, 0, 0, 0);
+        cellLayout->setSpacing(6);
+        auto *icon = new QPushButton("+", cell);
+        icon->setFixedSize(72, 72);
+        icon->setStyleSheet(
+            QStringLiteral(
+                "QPushButton { background-color: #555555; color: #ffffff; "
+                "font-size: 30px; font-weight: bold; border-radius: %1px; }")
+                .arg(isFold ? "20" : "18"));
+        QObject::connect(icon, &QPushButton::clicked, this,
+                         [this] {
+                             this->addNewChat();
+                         });
+        cellLayout->addWidget(icon, 0, Qt::AlignCenter);
+        auto *label = new QLabel("New chat", cell);
+        label->setAlignment(Qt::AlignCenter);
+        label->setStyleSheet("font-size: 12px;");
+        cellLayout->addWidget(label);
+        grid->addWidget(cell, row, col);
+    }
+
+    if (index == 0)
+    {
+        auto *empty = new QLabel(
+            "No chats yet — tap + to add a channel.", this->gridWidget_);
+        empty->setWordWrap(true);
+        grid->addWidget(empty, row + 1, 0, 1, 4);
+    }
+
+    this->updateStyle();
+}
+
+void DeviceHomeScreen::openPage(QWidget *page)
+{
+    this->notebook_->select(page);
+    this->hide();
+    Q_EMIT this->chatOpened();
+}
+
+void DeviceHomeScreen::addNewChat()
+{
+    if (auto *page = this->notebook_->addPage(true))
+    {
+        this->hide();
+        Q_EMIT this->chatOpened();
+        (void)page;
+    }
+}
+
+}  // namespace chatterino
