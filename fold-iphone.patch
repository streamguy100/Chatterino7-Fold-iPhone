diff --git a/src/widgets/DevicePhone.cpp b/src/widgets/DevicePhone.cpp
new file mode 100644
index 000000000..f7655a17a
--- /dev/null
+++ b/src/widgets/DevicePhone.cpp
@@ -0,0 +1,115 @@
+// SPDX-FileCopyrightText: 2026 Contributors to Chatterino <https://chatterino.com>
+//
+// SPDX-License-Identifier: MIT
+
+#include "widgets/DevicePhone.hpp"
+
+#include "singletons/Settings.hpp"
+#include "singletons/Theme.hpp"
+#include "widgets/NotebookEnums.hpp"
+
+#include <QHBoxLayout>
+#include <QTime>
+
+namespace chatterino {
+
+bool deviceStyleIsFold()
+{
+    return getSettings()->deviceStyle.getValue() == "GalaxyFold";
+}
+
+void applyDeviceStyle(const QString &style)
+{
+    auto *settings = getSettings();
+    settings->deviceStyle.setValue(style);
+
+    // Theme switches live (Theme::update runs on the themeName signal).
+    if (style == "iPhone")
+    {
+        getTheme()->themeName.setValue("iPhoneDark");
+    }
+    else
+    {
+        getTheme()->themeName.setValue("GalaxyFold");
+    }
+
+    // Tabs go to the bottom on both phones (Window already listens to
+    // tabDirection and moves the notebook tabs live).
+    settings->tabDirection.setValue(NotebookTabLocation::Bottom);
+}
+
+DevicePhoneBar::DevicePhoneBar(QWidget *parent)
+    : QWidget(parent)
+{
+    auto *layout = new QHBoxLayout(this);
+    layout->setContentsMargins(14, 4, 14, 4);
+    layout->setSpacing(8);
+
+    this->timeLabel_ = new QLabel(this);
+    this->timeLabel_->setStyleSheet("font-size: 14px; font-weight: bold;");
+    layout->addWidget(this->timeLabel_);
+
+    layout->addStretch();
+
+    // The phone's camera: a punch-hole dot on the Fold, a black notch
+    // pill on iPhone. Restyled in updateBar() when the style changes.
+    this->cameraLabel_ = new QLabel(this);
+    layout->addWidget(this->cameraLabel_);
+
+    layout->addStretch();
+
+    this->statusLabel_ = new QLabel(QStringLiteral("5G  100%"), this);
+    this->statusLabel_->setStyleSheet("font-size: 13px; font-weight: bold;");
+    layout->addWidget(this->statusLabel_);
+
+    this->setFixedHeight(36);
+
+    QObject::connect(&this->clockTimer_, &QTimer::timeout, this, [this] {
+        this->timeLabel_->setText(QTime::currentTime().toString("h:mm"));
+    });
+    this->clockTimer_.start(15000);
+    this->timeLabel_->setText(QTime::currentTime().toString("h:mm"));
+
+    getSettings()->deviceStyle.connect(
+        [this](const QString &) {
+            this->updateBar();
+        },
+        this->signalHolder_);
+
+    this->updateBar();
+}
+
+void DevicePhoneBar::updateBar()
+{
+    const bool isFold = deviceStyleIsFold();
+    const bool lightTheme = getTheme()->isLightTheme();
+    const QString textColor = lightTheme ? "#000000" : "#ffffff";
+    const QString barColor =
+        isFold ? "#121417" : (lightTheme ? "#f2f2f7" : "#1c1c1e");
+
+    this->setStyleSheet(QStringLiteral("background-color: %1;").arg(barColor));
+    this->timeLabel_->setStyleSheet(
+        QStringLiteral("color: %1; font-size: 14px; font-weight: bold;")
+            .arg(textColor));
+    this->statusLabel_->setStyleSheet(
+        QStringLiteral("color: %1; font-size: 13px; font-weight: bold;")
+            .arg(textColor));
+
+    if (isFold)
+    {
+        // Samsung Galaxy Fold: punch-hole camera, a small black dot.
+        this->cameraLabel_->setFixedSize(14, 14);
+        this->cameraLabel_->setStyleSheet(
+            "background-color: #000000; border: 1px solid #444444; "
+            "border-radius: 7px;");
+    }
+    else
+    {
+        // iPhone: notch, a black pill.
+        this->cameraLabel_->setFixedSize(92, 22);
+        this->cameraLabel_->setStyleSheet(
+            "background-color: #000000; border-radius: 11px;");
+    }
+}
+
+}  // namespace chatterino
