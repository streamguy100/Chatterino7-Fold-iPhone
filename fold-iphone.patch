+{
+    BaseWindow::resizeEvent(event);
+    if (this->homeScreen_ != nullptr)
+    {
+        this->homeScreen_->setGeometry(this->rect());
+    }
+    if (this->passcodeScreen_ != nullptr)
+    {
+        this->passcodeScreen_->setGeometry(this->rect());
+    }
 }
 
 void Window::addCustomTitlebarButtons()
