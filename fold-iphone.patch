+
+#include "widgets/settingspages/CodeScreenPage.hpp"
+
+#include "singletons/Settings.hpp"
+#include "widgets/DevicePasscode.hpp"
+
+#include <QLabel>
+#include <QLineEdit>
+#include <QRegularExpressionValidator>
+#include <QVBoxLayout>
+
+namespace chatterino {
+
+CodeScreenPage::CodeScreenPage()
+{
+    auto *layout = new QVBoxLayout(this);
+    layout->setContentsMargins(12, 12, 12, 12);
+    layout->setSpacing(10);
+
+    auto *title = new QLabel("Code Screen", this);
+    title->setStyleSheet("font-size: 18px; font-weight: bold;");
+    layout->addWidget(title);
+
+    auto *description = new QLabel(
+        "Lock the app behind a code on launch. The lock screen looks "
+        "like the phone you picked in Device Style: iOS \"Enter "
+        "Passcode\" on iPhone, Samsung \"Enter PIN\" on the Galaxy Fold.",
+        this);
+    description->setWordWrap(true);
+    layout->addWidget(description);
+
+    // Toggle: Code Screen on/off.
+    auto *toggle = this->createCheckBox(
+        "Code Screen — ask for a code every time the app opens",
+        getSettings()->codeScreenEnabled);
+    layout->addWidget(toggle);
+    QObject::connect(toggle, &QCheckBox::toggled, this, [this](bool checked) {
+        if (!checked)
+        {
+            // Turning it off again brings the "no passcode yet" hint
+            // back, so he is nudged to set a code again.
+            getSettings()->passcodeHintDismissed.setValue(false);
+        }
+        this->refreshLabels();
+    });
+
+    // Hint: shown whenever the app is NOT protected, here in Settings
+    // as well as in the dismissible banner above the chats.
+    this->hintLabel_ = new QLabel(
+        "No passcode set yet — anyone using this PC can type as you. "
+        "Turn on Code Screen and set a code to lock the app.",
+        this);
+    this->hintLabel_->setWordWrap(true);
+    this->hintLabel_->setStyleSheet("font-weight: bold;");
+    layout->addWidget(this->hintLabel_);
+
+    auto *codeLabel = new QLabel("Your code (4-6 digits):", this);
+    layout->addWidget(codeLabel);
+
+    this->codeEdit_ = new QLineEdit(this);
+    this->codeEdit_->setEchoMode(QLineEdit::Password);
+    this->codeEdit_->setMaxLength(6);
+    this->codeEdit_->setValidator(new QRegularExpressionValidator(
+        QRegularExpression("[0-9]*"), this));
+    this->codeEdit_->setPlaceholderText("4-6 digits");
+    this->codeEdit_->setText(getSettings()->passcodeCode.getValue());
+    layout->addWidget(this->codeEdit_);
+
+    this->savedLabel_ = new QLabel(this);
+    this->savedLabel_->setWordWrap(true);
+    layout->addWidget(this->savedLabel_);
+
+    QObject::connect(this->codeEdit_, &QLineEdit::textChanged, this,
+                     [this](const QString &text) {
+                         if (text.isEmpty())
+                         {
+                             // Clearing the code unprotects the app and
+                             // brings the hint back.
+                             getSettings()->passcodeCode.setValue(QString());
+                             getSettings()->passcodeHintDismissed.setValue(
+                                 false);
+                             this->savedLabel_->setText(
+                                 "Code cleared — the app will not lock. "
+                                 "Set a new code or turn Code Screen off.");
+                         }
+                         else if (text.length() >= 4)
+                         {
+                             // Changing the code here just saves it.
+                             getSettings()->passcodeCode.setValue(text);
+                             this->savedLabel_->setText(
+                                 "Code saved — the app will ask for it on "
+                                 "launch when Code Screen is on.");
+                         }
+                         else
+                         {
+                             this->savedLabel_->setText(
+                                 "Enter 4-6 digits to save a code.");
+                         }
+                         this->refreshLabels();
+                     });
+
+    this->statusLabel_ = new QLabel(this);
+    this->statusLabel_->setWordWrap(true);
+    layout->addWidget(this->statusLabel_);
+
+    auto *note = new QLabel(
+        "Your code is stored locally in the app settings on this PC. "
+        "It is a local lock screen, not real account security — anyone "
+        "who can read your settings file could read it.",
+        this);
+    note->setWordWrap(true);
+    layout->addWidget(note);
+
+    // Forgot code on the lock screen: there is a "Forgot code?" button
+    // right on the lock screen itself. Tapping it lets him set a new
+    // code there, with no old code asked and no extra step.
+    auto *forgotNote = new QLabel(
+        "Forgot your code? On the lock screen, tap \"Forgot code?\" "
+        "and set a new one — no old code needed.",
+        this);
+    forgotNote->setWordWrap(true);
+    layout->addWidget(forgotNote);
+
+    // Keep the labels right if the settings change elsewhere.
+    getSettings()->codeScreenEnabled.connect(
+        [this](bool) {
+            this->refreshLabels();
+        },
+        this->managedConnections_);
+    getSettings()->passcodeCode.connect(
+        [this](const QString &) {
+            this->refreshLabels();
+        },
+        this->managedConnections_);
+
+    this->refreshLabels();
+    layout->addStretch();
+}
+
+void CodeScreenPage::refreshLabels()
+{
+    const bool protected_ = DevicePasscodeScreen::lockActive();
+    this->hintLabel_->setVisible(!protected_);
+    if (protected_)
+    {
+        this->statusLabel_->setText(
+            "Code Screen is on — the app will ask for your code on "
+            "launch.");
+    }
+    else if (getSettings()->codeScreenEnabled.getValue())
+    {
+        this->statusLabel_->setText(
+            "Code Screen is on, but no code is set yet — set a code "
+            "above, or the app will open straight to chats.");
+    }
+    else
+    {
+        this->statusLabel_->setText(
+            "Code Screen is off — the app opens straight to chats.");
+    }
+}
+
+}  // namespace chatterino
